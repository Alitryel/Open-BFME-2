@@ -0,0 +1,18 @@
+// cl: /O2 /G7 /arch:SSE /MD
+// Native mss32.dll import thunks. These are real PE IAT symbols,
+// not aliases or replacement data; cl emits a tail jump through each slot.
+// Parameter widths follow the existing MilesAudioManager / OpenDevice calls.
+extern "C" {
+typedef void (__stdcall *Orientation)(void*,float,float,float,float,float,float);
+extern Orientation __identifier("_imp__AIL_set_3D_orientation@28");
+void __stdcall AIL_set_3D_orientation(void *object,float fx,float fy,float fz,float ux,float uy,float uz)
+{ return __identifier("_imp__AIL_set_3D_orientation@28")(object,fx,fy,fz,ux,uy,uz); }
+typedef int (__stdcall *Startup)(int,int,unsigned int,int,int);
+extern Startup __identifier("_imp__AIL_quick_startup@20");
+int __stdcall AIL_quick_startup(int digital,int midi,unsigned int rate,int bits,int channels)
+{ return __identifier("_imp__AIL_quick_startup@20")(digital,midi,rate,bits,channels); }
+typedef void (__stdcall *Info)(void*,int*,int*,int*,int*);
+extern Info __identifier("_imp__AIL_stream_info@20");
+void __stdcall AIL_stream_info(void *stream,int *rate,int *type,int *length,int *memory)
+{ return __identifier("_imp__AIL_stream_info@20")(stream,rate,type,length,memory); }
+}
