/// object of the template.
/// \see CurseSpecialPower

/// \fn Module *CurseSpecialPower::friend_newModuleInstance(Thing *thing, const ModuleData *moduleData)
/// \brief Instance factory registered for "CurseSpecialPower": creates the
///        module for one object.
