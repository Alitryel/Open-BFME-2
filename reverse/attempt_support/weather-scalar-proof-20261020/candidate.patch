+             "strong": {}, "comdat": {"_consume": [(1, "good", "retail"), (2, "bad", "unknown")]},
+             "selection": {"exceptions": {}}}
+    assert scalar_callee_holder("_consume", obj, ([], []), index) == "consumer.obj"
+    index["selection"]["exceptions"]["_consume"] = 2
+    assert scalar_callee_holder("_consume", obj, ([], []), index) == "other.obj"
+    index["selection"]["exceptions"]["_consume"] = None
+    assert scalar_callee_holder("_consume", obj, ([], []), index) is None
+    index["selection"]["exceptions"].clear()
+    assert scalar_callee_holder("_consume", obj, ([], ["_consume"]), index) == "caller.obj"
+    # An old caller definition that the new object removed must not be selected.
+    index["strong"]["_consume"] = [0]
+    assert scalar_callee_holder("_consume", obj, ([], []), index) == "consumer.obj"
