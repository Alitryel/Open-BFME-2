diff --git a/tools/tests/test_diffexec_local_static.py b/tools/tests/test_diffexec_local_static.py
new file mode 100644
index 0000000..5cf2194
--- /dev/null
+++ b/tools/tests/test_diffexec_local_static.py
@@ -0,0 +1,199 @@
+"""diffexec binds a TU-local (COFF class 3) referent by its own object.
+
+A `linkage=static` data row makes a local and another unit's global share a raw
+spelling legal. Round 9 filtered locals out of `ctx.data` but left `bind()`
+resolving the bare name through defs/map/data first, so a local `_sep` holding
+99 bound to another unit's external `_sep` at 7 and `diff_row` reported
+"identical after linker resolution". These tests assert the actual bind/diff_row
+result, not that a loader filtered a row.
+"""
+import struct
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+diffexec = pytest.importorskip("diffexec")
+pytest.importorskip("unicorn")
+import test_diffexec as td  # noqa: E402
+
+BASE = 0x400000
+LOAD, STORE, RET = b"\xa1", b"\xa3", b"\xc3"
+
+
+@pytest.fixture(autouse=True, scope="module")
+def quiet_faulthandler():
+    """The same handled first-chance probes test_diffexec documents: Unicorn's
+    TCG takes and handles one access violation per engine on Windows and
+    pytest's faulthandler prints each as a fatal exception. Mute the printing
+    only; assertions and real failures are untouched."""
+    import faulthandler
+    was = faulthandler.is_enabled()
+    faulthandler.disable()
+    yield
+    if was:
+        faulthandler.enable()
+
+
+def local_object(value):
+    """`_f` is `mov eax, [_sep]; ret`; the object defines STATIC `_sep` = value."""
+    code = LOAD + struct.pack("<I", 0) + RET
+    return td.coff([(".text", td.TEXT, code, [(1, 1, 0x06)]),
+                    (".data", 0xC0300040, struct.pack("<I", value), [])],
+                   [("_f", 0, 1, 0x20, 2, 0), ("_sep", 0, 2, 0, 3, 0)])
+
+
+def bss_local_object():
+    """`_f` is `mov eax, [_sep]; ret`; `_sep` is a TU-local .bss datum: no bytes."""
+    code = LOAD + struct.pack("<I", 0) + RET
+    return td.coff([(".text", td.TEXT, code, [(1, 1, 0x06)]),
+                    (".bss", 0xC0300080, b"", [])],
+                   [("_f", 0, 1, 0x20, 2, 0), ("_sep", 0, 2, 0, 3, 0)])
+
+
+def run(tmp_path, value, retail, data, emulate_identical=False):
+    obj = local_object(value)
+    memory = {0x1000: LOAD + struct.pack("<I", retail) + RET, 0x3000: struct.pack("<I", 7),
+              0x3004: struct.pack("<I", 99)}
+    function = td.row("_f", 0x1000, 6)
+    return td.verdict(tmp_path, obj, memory, [function], function, data=data,
+                      emulate_identical=emulate_identical)
+
+
+def run_bss(tmp_path, data, emulate_identical=False):
+    obj = bss_local_object()
+    memory = {0x1000: LOAD + struct.pack("<I", BASE + 0x3000) + RET,
+              0x3000: struct.pack("<I", 7)}
+    function = td.row("_f", 0x1000, 6)
+    return td.verdict(tmp_path, obj, memory, [function], function, data=data,
+                      emulate_identical=emulate_identical)
+
+
+def test_a_local_is_not_bound_to_another_units_external_of_the_same_name(tmp_path):
+    """value 99 in this TU, retail/global 7: the external map must not answer."""
+    verdict, record = run(tmp_path, 99, BASE + 0x3000, {"_sep": 0x3000})
+    assert verdict == "logic", record
+    assert record["sites"] == {"content-mismatch": 1}, record
+    assert record["bytes_equal"] is False
+
+
+def test_the_same_fixture_without_the_external_map_still_diverges(tmp_path):
+    verdict, record = run(tmp_path, 99, BASE + 0x3000, None)
+    assert verdict == "logic" and record["sites"] == {"content-mismatch": 1}, record
+
+
+def test_a_local_whose_own_bytes_are_retails_binds_by_content(tmp_path):
+    verdict, record = run(tmp_path, 99, BASE + 0x3004, {"_sep": 0x3000})
+    assert verdict == "none", record
+    assert record["sites"] == {"content": 1}, record
+
+
+def test_an_uninitialised_local_is_marked_unverified_not_resolved(tmp_path):
+    """No bytes to compare: the site is explicit, never a global resolution."""
+    image = diffexec.Image.from_memory(BASE, {0x1000: RET, 0x3000: struct.pack("<I", 7)},
+                                       exec_ranges=[(0x1000, 0x1001)])
+    ctx = diffexec.Context(image, [], data_ledger={"_sep": 0x3000})
+    symbols = [{"name": "_f", "section": 1, "value": 0, "type": 0x20, "storage": 2},
+               {"name": "_sep", "section": 2, "value": 0, "type": 0, "storage": 3}]
+    target, source = diffexec.bind(ctx, {"target_rva": "0x1000"}, "_sep", 1, symbols,
+                                   {"section": 1, "value": 0}, None, None, BASE + 0x3000, {})
+    assert source == "local-unverified" and target == BASE + 0x3000
+
+
+def test_a_local_referent_never_uses_defs_map_alias_or_pins(tmp_path):
+    """Every bare-name route is preceded by the storage-class dispatch."""
+    image = diffexec.Image.from_memory(BASE, {0x1000: RET, 0x3000: struct.pack("<I", 7)},
+                                       exec_ranges=[(0x1000, 0x1001)])
+    ctx = diffexec.Context(image, [td.row("_sep", 0x3000, 4)], [("_sep", 0x3000)],
+                           data_ledger={"_sep": 0x3000}, consensus={"_sep": BASE + 0x3000},
+                           map_publics={"_sep": 0x3000})
+    symbols = [{"name": "_f", "section": 1, "value": 0, "type": 0x20, "storage": 2},
+               {"name": "_sep", "section": 2, "value": 0, "type": 0, "storage": 3}]
+    for route in ("defs", "data", "consensus", "map"):
+        target, source = diffexec.bind(ctx, {"target_rva": "0x1000"}, "_sep", 1, symbols,
+                                       {"section": 1, "value": 0}, None, None, BASE + 0x3000, {})
+        assert source == "local-unverified", (route, source)
+    # the global routes are still there for an EXTERNAL referent of that name
+    external = [dict(symbols[0]), dict(symbols[1], storage=2)]
+    _target, source = diffexec.bind(ctx, {"target_rva": "0x1000"}, "_sep", 1, external,
+                                    {"section": 1, "value": 0}, None, None, BASE + 0x3000, {})
+    assert source == "ledger"
+
+
+def test_same_section_self_binding_survives_a_global_of_the_same_spelling(tmp_path):
+    """A local in the row's own section is placed relative to the body even when
+    a global function of that spelling exists in the ledger."""
+    image = diffexec.Image.from_memory(BASE, {0x1000: RET}, exec_ranges=[(0x1000, 0x1001)])
+    ctx = diffexec.Context(image, [td.row("_label", 0x2000, 1)])
+    symbols = [{"name": "_f", "section": 1, "value": 0, "type": 0x20, "storage": 2},
+               {"name": "_label", "section": 1, "value": 4, "type": 0, "storage": 3}]
+    target, source = diffexec.bind(ctx, {"target_rva": "0x1000"}, "_label", 1, symbols,
+                                   {"section": 1, "value": 0}, None, None, BASE + 0x1000, {})
+    assert source == "self" and target == BASE + 0x1004
+
+
+# --------------------------------------------------- unresolved local verdicts
+
+def test_an_uninitialised_local_is_inconclusive_on_the_fast_path(tmp_path):
+    """Round14: bytes_equal (retail's copied operand) returned verdict none for
+    a .bss local with no comparable bytes. Missing evidence is inconclusive."""
+    verdict, record = run_bss(tmp_path, data=None)
+    assert verdict == "inconclusive", record
+    assert record["sites"] == {"local-unverified": 1}, record
+    assert record["unverified_sites"] == 1
+    assert record["bytes_equal"] is True
+    assert "TU-local" in record["reason"]
+
+
+def test_an_uninitialised_local_is_inconclusive_when_execution_is_forced(tmp_path):
+    """emulate_identical=True runs both sides, but the run cannot prove the
+    missing local storage: three equal vectors must not become none."""
+    verdict, record = run_bss(tmp_path, data=None, emulate_identical=True)
+    assert verdict == "inconclusive", record
+    assert record["sites"] == {"local-unverified": 1}, record
+    assert record["ends"] == ["return", "return", "return"], record
+    assert "TU-local" in record["reason"]
+
+
+def test_an_unverified_local_ignores_a_same_spelled_external_map(tmp_path):
+    """The external map must not turn the unresolved local into equality."""
+    for forced in (False, True):
+        verdict, record = run_bss(tmp_path, data={"_sep": 0x3000}, emulate_identical=forced)
+        assert verdict == "inconclusive", (forced, record)
+        assert record["sites"] == {"local-unverified": 1}, record
+
+
+def test_a_genuine_local_divergence_still_stands(tmp_path):
+    """Fail-closed must not hide a real divergence: initialized 99 vs 7 stays logic."""
+    for forced in (False, True):
+        verdict, record = run(tmp_path, 99, BASE + 0x3000, {"_sep": 0x3000},
+                              emulate_identical=forced)
+        assert verdict == "logic", (forced, record)
+        assert record["sites"] == {"content-mismatch": 1}, record
+
+
+def test_an_initialized_local_equal_to_retail_still_passes(tmp_path):
+    """The resolved case (this object's bytes ARE retail's) is unchanged."""
+    for forced in (False, True):
+        verdict, record = run(tmp_path, 99, BASE + 0x3004, {"_sep": 0x3000},
+                              emulate_identical=forced)
+        assert verdict == "none", (forced, record)
+        assert record["sites"] == {"content": 1}, record
+
+
+def test_an_external_referent_still_resolves_through_the_data_ledger(tmp_path):
+    """External-only regression: an EXTERNAL `_sep` is bound by the ledger, not
+    by the local path, and a matching body reports none."""
+    code = LOAD + struct.pack("<I", 0) + RET
+    obj = td.coff([(".text", td.TEXT, code, [(1, 1, 0x06)]),
+                   (".data", 0xC0300040, struct.pack("<I", 7), [])],
+                  [("_f", 0, 1, 0x20, 2, 0), ("_sep", 0, 2, 0, 2, 0)])
+    memory = {0x1000: LOAD + struct.pack("<I", BASE + 0x3000) + RET,
+              0x3000: struct.pack("<I", 7)}
+    function = td.row("_f", 0x1000, 6)
+    verdict, record = td.verdict(tmp_path, obj, memory, [function], function,
+                                 data={"_sep": 0x3000})
+    assert verdict == "none", record
+    assert record["sites"] == {"data-ledger": 1}, record
