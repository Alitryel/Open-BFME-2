+
+    def probe(source_path, symbol):
+        source.write_text("static char _sep[2] = {'x', 'y'};\n", encoding="utf-8")
+        return 1, "simulated sizeof probe at the prior source"
+
+    def current(source_path, target):
+        return source.read_bytes() == original
+
+    code, logged = gate(tmp_path, monkeypatch, entry, image, probe_sizer=probe, is_current=current)
+    assert code == 1 and "changed during verification" in logged[0], logged
+
+
+def test_a_dependency_or_flag_change_after_the_probe_fails_closed(tmp_path, monkeypatch):
+    """The build's own currentness check also covers recorded headers and the
+    compiler command/flags; a change there is the same missing proof."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    _obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    stable = {"value": True}
+
+    def probe(source_path, symbol):
+        stable["value"] = False          # a header/flag changed while proving
+        return 1, "simulated sizeof probe"
+
+    code, logged = gate(tmp_path, monkeypatch, entry, image, probe_sizer=probe,
+                        is_current=lambda source_path, target: stable["value"])
+    assert code == 1 and "changed during verification" in logged[0], logged
+
+
+def test_compile_false_is_object_only_and_claims_no_source_freshness(tmp_path, monkeypatch):
+    """The census's archived-object path proves the object it read, not that the
+    source still emits it. It must not consult (or pretend to consult) the
+    source/build inputs, and the report says so."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    _obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    source = tmp_path / "Code" / "G.cpp"
+    checks = []
+
+    def probe(source_path, symbol):
+        source.write_text("static char _sep[2] = {'x', 'y'};\n", encoding="utf-8")
+        return 1, "simulated sizeof probe"
+
+    def current(source_path, target):
+        checks.append(str(source_path))
+        return False
+
+    code, logged = gate(tmp_path, monkeypatch, entry, image, probe_sizer=probe,
+                        is_current=current, compile=False)
+    assert code == 1 and logged == ["Data rows: OK (1 row(s) byte-verified)"], logged
+    assert checks == []                  # object-only: no fresh-source claim
+
+
+# ------------------------------------------------------------------- compile receipt
+
+def test_a_stable_receipt_passes_the_real_currentness_check(tmp_path, monkeypatch):
+    """The REAL build.compile_is_current accepts the receipt captured with the
+    snapshot: its source hash, empty deps and synthetic command fingerprint are
+    the live ones, and its path/object binding is the proof's own."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    _obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    code, logged = gate(tmp_path, monkeypatch, entry, image, real_current=True)
+    assert code == 1, logged
+    assert logged == ["Data rows: OK (1 row(s) byte-verified)"]
+
+
+def test_a_receipt_for_another_object_fails_closed(tmp_path, monkeypatch):
+    """Review16(a): the real helper ignores the receipt's `object` field, so a
+    receipt whose MD5 names a different object would pass currentness. The
+    snapshot binds it to the immutable bytes read and refuses."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    source = tmp_path / "Code" / "G.cpp"
+    write_receipt(obj, source, object=hashlib.md5(b"a different compiled object").hexdigest())
+    code, logged = gate(tmp_path, monkeypatch, entry, image, real_current=True, receipt=False)
+    assert code == 1 and "does not describe these bytes" in logged[0], logged
+
+
+def test_a_receipt_for_another_source_fails_closed(tmp_path, monkeypatch):
+    """The receipt's `path` is the canonical source identity: a receipt for
+    another source (or another spelling of it) is not this row's evidence."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    source = tmp_path / "Code" / "G.cpp"
+    write_receipt(obj, source, path="Code/H.cpp")
+    code, logged = gate(tmp_path, monkeypatch, entry, image, current=True, receipt=False)
+    assert code == 1 and "not bound to this source" in logged[0], logged
+
+
+def test_a_receipt_for_other_source_bytes_fails_closed(tmp_path, monkeypatch):
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    source = tmp_path / "Code" / "G.cpp"
+    write_receipt(obj, source, source=hashlib.md5(b"other source bytes").hexdigest())
+    code, logged = gate(tmp_path, monkeypatch, entry, image, current=True, receipt=False)
+    assert code == 1 and "does not describe this source's current bytes" in logged[0], logged
+
+
+def test_a_missing_or_malformed_receipt_fails_closed(tmp_path, monkeypatch):
+    """compile=True claims this source emits these bytes; without a receipt
+    that names the source and the object, that claim is unproven."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    code, logged = gate(tmp_path, monkeypatch, entry, image, current=True, receipt=False)
+    assert code == 1 and "has no compile receipt" in logged[0], logged
+    data_rows._tools()[0]._deps_sidecar(obj).write_text("{not json")
+    code, logged = gate(tmp_path, monkeypatch, entry, image, current=True, receipt=False)
+    assert code == 1 and "not readable JSON" in logged[0], logged
+
+
+def test_a_receipt_replaced_during_the_size_probe_fails_closed(tmp_path, monkeypatch):
+    """Review16(b): replace the source AND its receipt during the probe with a
+    coherent pair naming a different object. The original snapshot object is
+    untouched, so a final live currentness check would pass; the captured
+    receipt bytes differ, so the new inputs cannot bless the old bytes."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    source = tmp_path / "Code" / "G.cpp"
+
+    def probe(source_path, symbol):
+        source.write_text("static char _sep[2] = {'x', 'y'};\n", encoding="utf-8")
+        write_receipt(obj, source, object=hashlib.md5(b"new object not snapshot").hexdigest())
+        return 1, "size probe captured the earlier source"
+
+    code, logged = gate(tmp_path, monkeypatch, entry, image, probe_sizer=probe, real_current=True)
+    assert code == 1 and "compile receipt was replaced" in logged[0], logged
+
+
+def test_a_receipt_swap_with_the_same_object_still_fails_closed(tmp_path, monkeypatch):
+    """Even a receipt that names the SAME object bytes is not interchangeable:
+    the exact captured receipt is part of the proof."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    source = tmp_path / "Code" / "G.cpp"
+
+    def probe(source_path, symbol):
+        write_receipt(obj, source, cmd="0" * 32)     # same object, different command evidence
+        return 1, "simulated sizeof probe"
+
+    code, logged = gate(tmp_path, monkeypatch, entry, image, probe_sizer=probe, current=True)
+    assert code == 1 and "compile receipt was replaced" in logged[0], logged
+
+
+def test_a_recorded_header_change_after_the_probe_fails_closed(tmp_path, monkeypatch):
+    """The REAL helper hashes every recorded header: a header edited during the
+    sizeof probe leaves the object bytes intact but breaks the claim."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    source = tmp_path / "Code" / "G.cpp"
+    header = tmp_path / "Code" / "G.h"
+    header.write_text("// header v1\n", encoding="utf-8")
+    write_receipt(obj, source, deps={"Code/G.h": hashlib.md5(header.read_bytes()).hexdigest()})
+
+    def probe(source_path, symbol):
+        header.write_text("// header v2\n", encoding="utf-8")
+        return 1, "simulated sizeof probe"
+
+    code, logged = gate(tmp_path, monkeypatch, entry, image, probe_sizer=probe,
+                        real_current=True, receipt=False)
+    assert code == 1 and "changed during verification" in logged[0], logged
+
+
+def test_an_external_row_needs_no_compile_receipt(tmp_path, monkeypatch):
+    """The receipt binding is a static-row claim. External rows keep their
+    round15 path: object bytes, sizeof, content and relocation targets."""
+    (tmp_path / "Code").mkdir(exist_ok=True)
+    (tmp_path / "Code/G.cpp").write_text("// fixture\n", encoding="utf-8")
+    obj = tmp_path / "G.obj"
+    write_coff(obj, [(".data", DATA_FLAGS, struct.pack("<I", 7), 4, [])], [("?g@@3HA", 0, 1, 2)])
+    build = data_rows._tools()[0]
+    monkeypatch.setattr(data_rows, "ROOT", tmp_path)
+    monkeypatch.setattr(build, "obj_path", lambda source, member=None: obj)
+    entry = dict(zip(data_rows.FIELDS, row()))
+    code, logged = gate(tmp_path, monkeypatch, entry, image_with(data=struct.pack("<I", 7)),
+                        current=True, receipt=False)
+    assert code == 1 and logged == ["Data rows: OK (1 row(s) byte-verified)"], logged
+
+
+# --------------------------------------------------------------------------- exposure
+
+def test_a_local_row_is_never_a_global_home(tmp_path, monkeypatch):
+    build = data_rows._tools()[0]
+    symbols = tmp_path / "symbols.csv"
+    symbols.write_text("name,address,notes\n")
+    monkeypatch.setattr(data_rows, "SYMBOLS", symbols)
+    monkeypatch.setattr(data_rows, "DIR32_ADDRESSES", tmp_path / "absent.csv")
+    monkeypatch.setattr(build, "load_function_rows", lambda: [])
+    monkeypatch.setattr(data_rows, "retail_sections", lambda exe=None: SECTIONS)
+    rows = [dict(zip(data_rows.FIELDS, srow())),
+            dict(zip(data_rows.FIELDS, srow(address="0x00403004", source="Code/H.cpp", linkage="external")))]
+    resolve = data_rows.Resolver(rows)
+    # only the external row is a home: the local's address is not offered to anyone
+    assert resolve(SEP) == resolve(SEP, False) == {BASE + 0x3004}
+    assert data_rows.Resolver([rows[0]])(SEP) == set()
+
+
+def test_a_local_and_an_external_of_one_spelling_resolve_apart(tmp_path, monkeypatch):
+    """The external row keeps its own address; the local one is invisible, so a
+    reference to it from another unit fails closed instead of binding here."""
+    build = data_rows._tools()[0]
+    symbols = tmp_path / "symbols.csv"
+    symbols.write_text("name,address,notes\n")
+    monkeypatch.setattr(data_rows, "SYMBOLS", symbols)
+    monkeypatch.setattr(data_rows, "DIR32_ADDRESSES", tmp_path / "absent.csv")
+    monkeypatch.setattr(build, "load_function_rows", lambda: [])
+    monkeypatch.setattr(data_rows, "retail_sections", lambda exe=None: SECTIONS)
+    local = dict(zip(data_rows.FIELDS, srow()))
+    external = dict(zip(data_rows.FIELDS, srow(address="0x00403004", source="Code/H.cpp", linkage="external")))
+    assert data_rows.Resolver([local, external])(SEP) == {BASE + 0x3004}
+    assert data_rows.Resolver([local])(SEP) == set()
+    assert data_rows.linkage_of(local) == data_rows.STATIC_ROW
+    assert data_rows.linkage_of(external) == data_rows.EXTERNAL_ROW
+
+
+def test_load_static_keeps_the_source_identity(tmp_path, monkeypatch):
+    path = tmp_path / "data_rows.csv"
+    path.write_bytes(ledger(srow(), srow(address="0x00403004", source="Code/H.cpp"),
+                            srow("?g@@3HA", address="0x00403008", size="4", linkage="external")))
+    monkeypatch.setattr(data_rows, "DATA_ROWS", path)
+    assert [(r["source"], r["name"]) for r in data_rows.load_static()] == [
+        ("Code/G.cpp", SEP), ("Code/H.cpp", SEP)]
+    assert [r["name"] for r in data_rows.load()] == ["?g@@3HA"]
+    assert len(data_rows.load_all()) == 3
+
+
+# --------------------------------------------------------------------------- external regression
+
+def test_external_rows_still_verify_and_keep_their_shape(tmp_path, monkeypatch):
+    """No behaviour change for the 2,128 external rows: one EXTERNAL definition,
+    sizeof, content, relocation targets."""
+    (tmp_path / "Code").mkdir(exist_ok=True)
+    (tmp_path / "Code/G.cpp").write_text("// fixture\n")
+    obj = tmp_path / "G.obj"
+    write_coff(obj, [(".data", DATA_FLAGS, struct.pack("<I", 7), 4, [])], [("?g@@3HA", 0, 1, 2)])
+    build = data_rows._tools()[0]
+    monkeypatch.setattr(data_rows, "ROOT", tmp_path)
+    monkeypatch.setattr(build, "obj_path", lambda source, member=None: obj)
+    ok, message = verify_entry(image_with(data=struct.pack("<I", 7)), row())
+    assert ok, message
+    # a class-3 definition is still no external owner
+    write_coff(obj, [(".data", DATA_FLAGS, struct.pack("<I", 7), 4, [])], [("?g@@3HA", 0, 1, 3)])
+    ok, message = verify_entry(image_with(data=struct.pack("<I", 7)), row())
+    assert not ok and "is not defined once" in message
