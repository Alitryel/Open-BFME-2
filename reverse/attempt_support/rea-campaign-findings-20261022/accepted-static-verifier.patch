+def test_the_tie_derives_the_address_from_this_tus_own_static_reference(tmp_path, monkeypatch):
+    snapshot, image, rows = tie(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
+    assert data_rows.own_tu_reference_bases("Code/G.cpp", SEP, rows, snapshot, image) == {BASE + 0x3000}
+    # another unit's code is no evidence for this unit's TU-local name
+    assert data_rows.own_tu_reference_bases("Code/H.cpp", SEP, rows, snapshot, image) == set()
+    # an unrelated name reaches nothing
+    assert data_rows.own_tu_reference_bases("Code/G.cpp", "_other", rows, snapshot, image) == set()
+
