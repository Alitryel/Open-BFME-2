+                if kind == 0x14 and at + 4 <= len(native):
+                    struct.pack_into("<i", native, at, 0x2000 - (0x1000 + at + 4))
+            self.memory[0x1000] = bytes(native)
+            native_consumer = bytearray(self.consumer_raw)
+            if len(native_consumer) >= 12:
+                struct.pack_into("<I", native_consumer, 8, 0x403000)
+            self.memory[0x2000] = bytes(native_consumer)
+            self.memory[0x3000] = self.scale
+            (tmp_path / self.source).write_text(self.text)
+
+        def findings(self):
+            return L.addresses(self.text, source=self.source, obj=self.caller,
+                               truth=self.truth, selected=self.selected)
+
+    monkeypatch.setattr(build, "ROOT", tmp_path)
+    f = Fixture()
+    monkeypatch.setattr(build, "row_object",
+                        lambda row: f.caller if row["source"] == f.source else f.consumer)
+    monkeypatch.setattr(build, "compile_is_current", lambda *args, **kw: True)
+    return f
+
