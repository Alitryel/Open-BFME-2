+def test_a_truncated_branch_operand_is_not_padding(tmp_path, monkeypatch):
+    """Review16: `A0 <dir32> EB 90` with a 6 B row. The trailing 0x90 is the
+    signed operand of the two-byte `EB 90` short jump, not alignment. Round15
+    trimmed any 0x90 suffix and placed the datum while the REAL byte gate
+    reported a tail mismatch at +6. The extent now uses the gate's rule, so the
+    row is refused and the two verdicts agree."""
+    body = b"\xa0" + bytes(4) + b"\xeb\x90"
+    retail = b"\xa0" + struct.pack("<I", BASE + 0x3000) + b"\xeb\x91"
+    obj, snapshot = custom_text(tmp_path, monkeypatch, body,
+                                [(".text", 0, 1, 3), ("_f", 0, 1, 2, 0x20), (SEP, 0, 2, 3)],
+                                [(1, 2, data_rows.DIR32)])
+    image = image_with(data=b"\n", text=retail)
