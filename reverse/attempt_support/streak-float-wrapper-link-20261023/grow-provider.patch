+// BFME 1 96c88c73a5cd, game/Libraries/Source/WWVegas/WWLib/simplevec.h.
+// Float Add at 1683C3 calls the complete 59B Grow at 1001D5. Its virtual
+// Resize tail call makes the whole body a byte/relocation twin of the
+// existing BfmePod4 owner; the float identity comes from Add's callers.
+template<class T>
+inline bool SimpleDynVecClass<T>::Grow(int new_size_hint)
+{
+	int new_size = MAX(Length() + Length()/4, Length() + 4);
+	new_size = MAX(new_size, new_size_hint);
+	return Resize(new_size);
+}
