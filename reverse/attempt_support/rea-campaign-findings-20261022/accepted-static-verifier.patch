+class ObjectSnapshot:
+    """One source's object, held as immutable bytes and parsed once.
+
+    A static row's proof has two halves -- the datum (storage class, size,
+    extent, initializer) and its address (this unit's own verified reference) --
+    and both must describe the SAME object. Reading the object twice let a
+    compile between the phases pass a stale address check or fail a cold one.
+    Every proof phase below reads this snapshot's bytes only; verify() re-reads
+    the file digest before accepting, so a concurrent rebuild fails closed.
+
+    `receipt` is the compile receipt captured with the same read, for a static
+    row under compile=True: {"raw": sidecar bytes, "meta": parsed, "object":
+    MD5 of `data`}. The live currentness helper alone cannot say WHICH object a
+    receipt describes, so the binding is checked here once and its exact bytes
+    are preserved to the end of the proof."""
+
+    def __init__(self, source, path, data, receipt=None):
+        _, rl = _tools()
+        self.source = source
+        self.path = Path(path)
+        self.data = bytes(data)
+        self.digest = hashlib.sha256(self.data).hexdigest()
+        self.receipt = receipt
+        self.sections, self.symbols = rl.parse_coff(self.data)
