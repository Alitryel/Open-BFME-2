+template <> unsigned int vector<void *, allocator<void *> >::capacity() const;
+template <> void vector<void *, allocator<void *> >::reserve(unsigned int);
+template <> __declspec(dllimport) __forceinline
+void **vector<void*>::begin()
+{ return _M_start; }
+template <> __declspec(dllimport) __forceinline
+void **vector<void*>::end()
+{ return _M_finish; }
+template <> __declspec(dllimport) __forceinline
+size_t vector<void*>::size() const
+{ return size_t(this->_M_finish - this->_M_start); }
+template <> __declspec(dllimport) __forceinline
+void *&vector<void*>::operator[](size_t __n)
+{ return *(begin() + __n); }
+template<> hash_map<NameKeyType,int,rts::hash<NameKeyType> >::hash_map()
+ :_M_ht(100,hasher(),key_equal(),allocator_type()) {}
+template hash_map<NameKeyType,int,rts::hash<NameKeyType> >::hash_map();
+template<> void AIStatCountTable::clear() {
+ for(size_type bucket=0;bucket<_M_buckets.size();++bucket) {
+  _Node *node=(_Node *)_M_buckets[bucket];
+  while(node!=0) {
+   _Node *next=node->_M_next;
+   _M_delete_node(node);
+   node=next;
+  }
+  _M_buckets[bucket]=0;
+ }
+ _M_num_elements._M_data=0;
+}
+}
