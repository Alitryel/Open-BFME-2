+"""reverse/data_rows.csv `linkage=static`: TU-local data ownership.
+
+A file-static datum (COFF storage class 3) has no cross-unit name, so it cannot
+be an external data row: round 8 refused deleting the row to get past
+verify_row's EXTERNAL-only lookup, and refused admitting class 3 into a global
+name map. These tests hold the repair to the rules that refusal set out:
+
+  identity   (source, raw COFF name), from the row's `linkage` field -- never
+             from the name's spelling; external rows keep one owner per name.
+  shape      exactly one class-3 definition, in a non-executable object section,
+             that is neither a section symbol nor a compiler label.
+  proof      sizeof/allocation/content as for an external row, plus the claimed
+             retail address must be the ONE address the row's own source
+             derives through a DIR32 relocation whose COFF symbol index IS that
+             STATIC definition, in a function whose whole body is retail's.
+  one object the datum proof and the address proof read one immutable
+             ObjectSnapshot, so a cold rebuild cannot fail and a stale object
+             cannot authorize a rebuilt one. Its contributing extent uses the
+             byte gate's own rule: the next non-`$` symbol of the section with
+             COFF type 0x20 or EXTERNAL storage bounds it, and only 0xCC is
+             alignment padding -- 0x90 is an opcode or an operand.
+  receipt    compile=True also captures the compile receipt that produced the
+             snapshot: `path` must be this source's canonical identity, `object`
+             its MD5 of the immutable bytes, and the exact receipt bytes must
+             still be on disk, with the source/headers/command still matching,
+             after the proof. compile=False reads no receipt and claims no
+             freshness.
+  exposure   load(), Resolver, link_census's data_ledger, diffexec and
+             name_dependents.data_targets never see a local as a global.
+
+Every tie fixture below is COHERENT: the object defines the class-3 datum, the
+referencing function's body is retail's outside the relocation field, and the
+relocation names the STATIC symbol's index. Round 9's fixtures tied through an
+undefined EXTERNAL `_sep`, which is not evidence for a TU-local owner.
+
+The fixtures are test_data_rows.py's own COFF and PE writers, so the gate's
+object reader is what is exercised. Nothing here compiles.
+"""
+import hashlib
+import json
+import struct
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import data_rows  # noqa: E402
+from test_data_rows import (  # noqa: E402
+    BASE, SECTIONS, image_with, ledger, row, write_coff)
+
+SEP = "_sep"          # the shape of the FESL separator: static char _sep = '\n';
+TEXT_FLAGS = 0x60500020
+DATA_FLAGS = 0xC0300040
+SIZES = {SEP: 1, "_wide": 4, "?g@@3HA": 4}
+RET = b"\xc3"
+
+
+def sizer(source, symbol):
+    return (SIZES[symbol], "fixture sizeof") if symbol in SIZES else (None, "no fixture size")
+
+
+def srow(name=SEP, address="0x00403000", kind="va", size="1", section=".data",
+         source="Code/G.cpp", linkage="static"):
+    """An external row's fields plus its linkage (test_data_rows.row is 9 fields)."""
+    return row(name, address, kind, size, section, source) + [linkage]
+
+
+def problems_of(raw, sources_ok=None):
+    problems = []
+    data_rows.check(raw, problems, sources_ok, SECTIONS)
+    return problems
+
+
+# --------------------------------------------------------------------------- fixtures
+
+def write_refs(path, refs, data=b"\n", sep=(2, 3), sep_name=SEP):
+    """A COFF object whose .text holds one body per (function, addend, opcode).
+
+    Each body is `opcode, DIR32 <addend>, ret`. The relocation names the symbol
+    INDEX of `sep_name`, whose (section, storage) the caller chooses: section 2
+    storage 3 is the defined TU-local datum, section 0 storage 2 the
+    same-spelled undefined EXTERNAL a bad fixture would have tied through.
+    """
+    bodies, relocs = b"", []
+    symbols = [(".text", 0, 1, 3)]
+    for name, addend, opcode in refs:
+        start = len(bodies)
+        bodies += bytes([opcode]) + struct.pack("<I", addend) + RET
+        relocs.append((start + 1, len(refs) + 1, data_rows.DIR32))   # _sep's symbol index
+        symbols.append((name, start, 1, 2, 0x20))
+    symbols.append((sep_name, 0, sep[0], sep[1]))
+    write_coff(path, [(".text", TEXT_FLAGS, bodies, len(bodies), relocs),
+                      (".data", DATA_FLAGS, data, len(data), [])], symbols)
+    return path
+
+
+def retail_text(refs, pointers):
+    """Retail's .text: the same bodies with the linker's absolute pointers."""
+    out = b""
+    for (_name, _addend, opcode), pointer in zip(refs, pointers):
+        out += bytes([opcode]) + struct.pack("<I", pointer) + RET
+    return out
+
+
+def function_rows(refs, source="Code/G.cpp"):
+    return [{"name": name, "source": source, "status": "matched", "notes": "",
+             "target_rva": f"0x{0x1000 + 6 * index:04X}", "target_size": "6"}
+            for index, (name, _addend, _opcode) in enumerate(refs)]
+
+
+def tree(tmp_path, monkeypatch, refs, pointers, *, data=b"\n", sep=(2, 3), write=True,
+         retail_opcodes=None):
+    """A private Code/G.cpp tree, its object, the retail image, and the fakes
+    the verifier needs. Returns (object path, image, function rows)."""
+    (tmp_path / "Code").mkdir(parents=True, exist_ok=True)
+    (tmp_path / "Code/G.cpp").write_text("// fixture: static char _sep = '\\n';\n", encoding="utf-8")
+    obj = tmp_path / "G.obj"
+    if write:
+        write_refs(obj, refs, data, sep)
+    build, _ = data_rows._tools()
+    monkeypatch.setattr(data_rows, "ROOT", tmp_path)
+    monkeypatch.setattr(build, "ROOT", tmp_path)     # production: data_rows.ROOT is build.ROOT
+    monkeypatch.setattr(build, "obj_path", lambda source, member=None: obj)
+    rows = function_rows(refs)
+    monkeypatch.setattr(build, "load_function_rows", lambda: rows)
+    retail = refs if retail_opcodes is None else [
+        (name, addend, opcode) for (name, addend, _object), opcode in zip(refs, retail_opcodes)]
+    image = image_with(data=data, text=retail_text(retail, pointers))
+    return obj, image, rows
+
+
+def verify_entry(image, entry, homes=None):
+    resolve = homes if callable(homes) else (lambda name, function=None: (homes or {}).get(name, set()))
+    return data_rows.verify_row(dict(zip(data_rows.FIELDS, entry)), image, resolve,
+                                compile=False, sizer=sizer)
+
+
+SYNTHETIC_COMMAND = (["synthetic-cl", "-c"], {})
+
+
+def receipt_meta(obj, source_path, **overrides):
+    """The build's own receipt shape (build._write_deps_sidecar) for a synthetic
+    object: cmd fingerprint, source MD5, deps, source path and object MD5."""
+    build, _ = data_rows._tools()
+    command, env = SYNTHETIC_COMMAND
+    meta = {"cmd": build._cmd_fingerprint(command, env),
+            "source": build._hash_file(str(source_path)),
+            "deps": {}, "path": build._root_key(source_path), "object": build._hash_file(str(obj))}
+    meta.update(overrides)
+    return meta
+
+
+def write_receipt(obj, source_path, **overrides):
+    """Write a truthful synthetic compile receipt beside `obj` (overrides make a
+    deliberately unbound one)."""
+    meta = receipt_meta(obj, source_path, **overrides)
+    data_rows._tools()[0]._deps_sidecar(obj).write_text(json.dumps(meta))
+    return meta
+
+
+def gate(tmp_path, monkeypatch, entry, image, *, rebuild=None, current=False, probe_sizer=None,
+         is_current=None, compile=True, function_rows=None, receipt=True, real_current=False):
+    """Run the real data_rows.verify() over one row, with only the compiler,
+    the image and the function ledger substituted.
+
+    The synthetic receipt is written in the build's own shape for the object
+    that exists when the gate starts, so a static row's compile=True proof
+    exercises the real binding. `real_current=True` leaves
+    build.compile_is_current UNPATCHED: the real helper judges the receipt.
+    The default patches it and models a successful rebuild making the object
+    current, as round 13 did."""
+    build, rl = data_rows._tools()
+    monkeypatch.setattr(build, "ROOT", tmp_path)
+    monkeypatch.setattr(build, "compiler_command", lambda source, target: SYNTHETIC_COMMAND)
+    monkeypatch.setattr(data_rows, "load_all", lambda path=None: [entry])
+    monkeypatch.setattr(data_rows, "load", lambda path=None: [])
+    monkeypatch.setattr(data_rows, "Resolver", lambda rows: (lambda name, function=None: set()))
+    monkeypatch.setattr(data_rows, "compiled_size", probe_sizer or sizer)
+    monkeypatch.setattr(rl, "Image", lambda *a, **k: image)
+    if function_rows is not None:
+        monkeypatch.setattr(build, "load_function_rows", lambda: function_rows)
+    state = {"current": current}
+    if not real_current:
+        if is_current is None:
+            is_current = lambda source, target: state["current"]
+        monkeypatch.setattr(build, "compile_is_current", is_current)
+    if rebuild is not None:
+        def rebuilt(source, target):
+            result = rebuild(source, target)
+            state["current"] = True       # a successful rebuild makes the object current
+            return result
+        monkeypatch.setattr(build, "try_compile_source", rebuilt)
+    obj = build.obj_path(tmp_path / entry["source"])
+    if receipt and obj.exists():
+        write_receipt(obj, tmp_path / entry["source"])
+    logged = []
+    try:
+        count = data_rows.verify(compile=compile, log=logged.append)
+    except SystemExit as stop:
+        return stop.code, logged
+    return count, logged
+
+
+# --------------------------------------------------------------------------- integrity
+
+def test_a_static_row_is_identified_by_source_and_raw_name():
+    one = srow()
+    other = srow(address="0x00403004", source="Code/H.cpp")
+    assert problems_of(ledger(one, other)) == []          # two TUs, one spelling, two addresses
+    assert "one row per (source, name)" in problems_of(ledger(one, srow(address="0x00403004")))[0]
+    # an external row keeps tree-wide uniqueness
+    assert "one row per name" in problems_of(ledger(srow(linkage="external"),
+                                                    srow(address="0x00403004", linkage="external")))[0]
+
+
+def test_a_tu_may_not_own_one_spelling_both_ways():
+    both = ledger(srow(linkage="external"), srow(address="0x00403004"))
+    assert any("a TU defines a name once" in problem for problem in problems_of(both))
+    both = ledger(srow(), srow(address="0x00403004", source="Code/H.cpp", linkage="external"))
+    assert problems_of(both) == []                        # another unit's external is a different datum
+
+
+def test_overlap_and_one_owner_per_address_span_both_linkages():
