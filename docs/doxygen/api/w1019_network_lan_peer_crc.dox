/// \ingroup grp_w1019_network_lan_peer_crc
/// \brief The GameSpy Peer SDK's peerStopGame.
///
/// \see peerStopGame

/// \file Thread/PeerParseQueryThunk.cpp
/// \ingroup grp_w1019_network_lan_peer_crc
