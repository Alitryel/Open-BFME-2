/// nor Open-BFME-1's \c game/ tree.
///
/// \see ShipSlowDeathBehavior::friend_newModuleInstance, SlowDeathBehavior

/// \fn Module *ShipSlowDeathBehavior::friend_newModuleInstance(Thing *thing, const ModuleData *moduleData)
/// \brief Instance factory registered for "ShipSlowDeathBehavior": creates
