+@pytest.mark.parametrize("case", [
+    "callee_dereferences_argument", "callee_stores_raw_argument", "callee_calls_out",
+    "callee_returns_without_popping_argument", "wrong_scale", "wrong_retail_body",
+    "wrong_retail_callee", "unrowed_callee", "conflicting_callee_identity",
+    "caller_reads_pushed_word", "caller_changes_stack", "caller_branches",
+    "opcode_in_immediate", "duplicate_data_use", "duplicate_pointer_use",
+    "overlapping_relocations", "invalid_symbol_index", "caller_section_overrun",
+    "callee_section_overrun",
+])
+def test_scalar_proof_keeps_uncertain_or_pointer_uses(scalar_call, case):
+    from test_gate_exploits import RDATA
+
+    f = scalar_call
+    if case == "callee_dereferences_argument":
+        f.consumer_raw = f.consumer_raw[:13] + b"\x8b\x30" + f.consumer_raw[15:]  # mov esi,[eax]
+    elif case == "callee_stores_raw_argument":
+        f.consumer_raw = f.consumer_raw[:38] + b"\x89\x01\x90\x90" + f.consumer_raw[42:]
+    elif case == "callee_calls_out":
+        f.consumer_raw += b"\xe8\0\0\0\0\xc3"
+    elif case == "callee_returns_without_popping_argument":
+        f.consumer_raw = f.consumer_raw[:-3] + b"\xc3\x90\x90"
+    elif case == "wrong_scale":
+        f.scale = struct.pack("<f", 1.0)
+    elif case == "unrowed_callee":
+        f.rows.pop()
+    elif case == "conflicting_callee_identity":
+        f.truth.ledger["_consume"].add(0x4000)
+    elif case.startswith("caller_") and case not in ("caller_section_overrun",):
+        middle = {
+            "caller_reads_pushed_word": bytes.fromhex("8b1424"),
+            "caller_changes_stack": b"\x50",
+            "caller_branches": bytes.fromhex("7400"),
+        }[case]
+        f.raw = f.raw[:5] + middle + f.raw[5:]
+        f.relocs = [(6 + len(middle), 1, 0x14)]
+    elif case == "opcode_in_immediate":
+        # The apparent PUSH begins inside MOV EAX's immediate.
+        f.raw = b"\xb8\x68" + struct.pack("<I", f.value) + b"\xe8\0\0\0\0\xc3"
+        f.relocs = [(7, 1, 0x14)]
+    elif case == "duplicate_data_use":
+        f.extra = [(".rdata", RDATA, struct.pack("<I", f.value), [])]
+    elif case == "duplicate_pointer_use":
+        f.raw = f.raw[:-1] + b"\xa1" + struct.pack("<I", f.value) + b"\xc3"
+    elif case == "overlapping_relocations":
+        f.relocs += [(6, 1, 0x14)]
+    elif case == "invalid_symbol_index":
+        f.relocs = [(6, 99, 0x14)]
+    # Save before deleting the callee's ledger row: save updates both extents.
+    if case == "unrowed_callee":
+        f.rows.append(dict(name="_consume", source=f.callee_source, target_rva="0x2000", target_size="76"))
+        f.save()
+        f.rows.pop()
+    else:
+        f.save()
+    if case == "wrong_retail_body":
+        f.memory[0x2000] = b"\x90" + f.memory[0x2000][1:]
+    elif case == "wrong_retail_callee":
+        raw = bytearray(f.memory[0x1000])
+        struct.pack_into("<i", raw, 6, 0x4000 - 0x100A)
+        f.memory[0x1000] = bytes(raw)
+    elif case.endswith("_section_overrun"):
+        path = f.caller if case.startswith("caller") else f.consumer
+        raw = bytearray(path.read_bytes())
+        struct.pack_into("<I", raw, 20 + 16, len(raw) + 1)
+        path.write_bytes(raw)
+    assert f.findings() == ["0x886655"]
+
