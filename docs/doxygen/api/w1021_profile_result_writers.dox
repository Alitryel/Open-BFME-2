/// \fn const char *ProfileResultFileGTT::GetName(void) const
/// \brief Returns `file_gtt_dot`, the writer's registration name.
///
/// \warning Name not confirmed; see ProfileResultFileGTT. The function's
///          name follows the CSV and DOT writers' Zero Hour declarations.
///
