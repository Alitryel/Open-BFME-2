+def custom_text(tmp_path, monkeypatch, body, symbols, relocs, data=b"\n", source="Code/G.cpp"):
+    """A COFF object with one hand-written .text section, plus its snapshot."""
+    (tmp_path / "Code").mkdir(parents=True, exist_ok=True)
+    (tmp_path / source).write_text("// fixture\n", encoding="utf-8")
+    obj = tmp_path / "G.obj"
+    write_coff(obj, [(".text", TEXT_FLAGS, body, len(body), relocs),
+                     (".data", DATA_FLAGS, data, len(data), [])], symbols)
+    build = data_rows._tools()[0]
+    monkeypatch.setattr(data_rows, "ROOT", tmp_path)
+    monkeypatch.setattr(build, "obj_path", lambda source, member=None: obj)
+    return obj, data_rows.ObjectSnapshot(source, obj, obj.read_bytes())
+
