+# Complete x86 thiscall byte-channel conversion. The sole variable field is
+# the absolute float-pool load at +8, checked independently below. In order:
+# load the one stack argument; save ESI; extract bits 16..23, 8..15, 0..7;
+# convert each masked byte to float; multiply by 1/255; store at this+0/4/8;
+# restore ESI; RET 4. No raw argument escapes, address depends on it, branch,
+# call-out, or additional instruction is admitted. This is an instruction
+# idiom, not an exemption for a callee name, retail RVA or colour value.
+_BYTE_CHANNELS = bytes.fromhex(
+    "8b442404 f30f1005 00000000 56 8bf0 c1fe10 baff000000 23f2 "
+    "f30f2ace 8bf0 f30f59c8 c1fe08 f30f1109 23f2 f30f2ace "
+    "f30f59c8 f30f114904 23c2 f30f2ac8 f30f59c8 f30f114908 5e c20400"
+)
+_CHANNEL_SCALE = bytes.fromhex("8180803b")  # binary32 1/255
+
+
+class _ScalarCalls:
+    """One audit's bounded scalar-call proof; never caches a verdict or object."""
+
+    def __init__(self, truth, selected):
+        self.truth = truth
+        self.selected = selected
+        self.rows = getattr(truth, "address_rows", ())
+        self.used = []
+
+    def _object(self, row):
+        import build
+        from allowed_symbols import Obj
+
+        source = build.ROOT / row["source"]
+        path = build.row_object(row)
+        if source.suffix.lower() not in (".cpp", ".c") or not build.compile_is_current(source, path):
+            raise ValueError("no current ordinary provider")
+        source_content = source.read_bytes()
+        o = Obj(path)
+        for size, ptr, rptr, nrel, flags in o.sections:
+            if (ptr and ptr + size > len(o.data)) or (size and not ptr and not flags & 0x80):
+                raise ValueError("section outside object")
+            if nrel and (not rptr or rptr + nrel * 10 > len(o.data)):
+                raise ValueError("relocations outside object")
+            occupied = set()
+            for at in range(rptr, rptr + nrel * 10, 10):
+                where, index, kind = struct.unpack_from("<IIH", o.data, at)
+                width = 2 if kind == 0xA else 4
+                field = set(range(where, where + width))
+                if where + width > size or occupied & field or index not in o.symbols:
+                    raise ValueError("ambiguous relocation")
+                occupied |= field
+        self.used.append((row, source, path, o.data, source_content))
+        return o
+
+    def _body(self, o, row, *, identity=True):
+        name = row["name"]
+        symbols = [s for s in o.functions() if s["name"] == name and s["storage"] == 2]
+        if len(symbols) != 1 or symbols[0]["value"] != 0:
+            raise ValueError("no unique function entry")
+        symbol = symbols[0]
+        start, size = int(row["target_rva"], 16), int(row["target_size"])
+        if size <= 0 or set(self.truth.ledger.get(name, ())) != {start}:
+            raise ValueError("no unique ledger extent")
+        raw, extent, relocs = o.body(symbol)
+        section_size, ptr = o.sections[symbol["section"] - 1][:2]
+        if (raw is None or not ptr or not size <= extent <= section_size
+                or len(raw) != extent or any(b not in (0x90, 0xCC) for b in raw[size:])
+                or any(k not in (6, 0x14) or w < 0 or w + 4 > size for w, k, _ in relocs)):
+            raise ValueError("body outside proven extent")
+        raw = raw[:size]
+        native = self.truth._read(start, size)
+        if native is None:
+            raise ValueError("missing native body")
+        masked = bytearray(raw)
+        for where, kind, _ in relocs:
+            width = 2 if kind == 0xA else 4
+            masked[where:where + width] = native[where:where + width]
+        if bytes(masked) != native:
+            raise ValueError("body bytes differ")
+        # For the caller, unknown bindings outside the scalar window remain the
+        # ordinary link checks' responsibility. This proof says how this literal
+        # is consumed, not that the caller's unrelated code identities are right.
+        # The callee has no such exception: its entire body and every relocation
+        # must bind to retail before it can establish a scalar-use certificate.
+        if identity and self.truth._judge(start, symbol, raw, relocs, size) != "retail":
+            raise ValueError("body/relocation proof failed")
+        return symbol, raw, relocs
+
+    def _consumer(self, name):
+        rows = [r for r in self.rows if r["name"] == name]
+        if len(rows) != 1:
+            return False
+        row = rows[0]
+        o = self._object(row)
+        if self.selected(name) != o.path.name:
+            return False  # an unknown/different kept definition supplies no proof
+        _, raw, relocs = self._body(o, row)
+        if len(raw) != len(_BYTE_CHANNELS) or len(relocs) != 1:
+            return False
+        where, kind, ref = relocs[0]
+        if (where, kind) != (8, 6) or ref.get("content") != _CHANNEL_SCALE:
+            return False
+        if raw != _BYTE_CHANNELS:
+            return False
+        native = self.truth._read(int(row["target_rva"], 16), len(raw))
+        if native is None:
+            return False
+        pool = struct.unpack_from("<I", native, 8)[0] - 0x400000
+        return self.truth._read(pool, 4) == _CHANNEL_SCALE
+
+    def _site(self, raw, relocs, start, offset):
+        import capstone as cs
+        from capstone import x86_const as x
+
+        md = cs.Cs(cs.CS_ARCH_X86, cs.CS_MODE_32)
+        md.detail = True
+        instructions = list(md.disasm(raw, 0))
+        if sum(i.size for i in instructions) != len(raw):
+            return False
+        native = self.truth._read(start, len(raw))
+        native_instructions = list(md.disasm(native or b"", 0))
+        if ([(i.address, i.size, i.id) for i in native_instructions]
+                != [(i.address, i.size, i.id) for i in instructions]):
+            return False
+        # Relocation masking cannot change an opcode or cross an instruction.
+        # Only the decoded four-byte operand fields supported here are masked.
+        for where, kind, _ in relocs:
+            owners = [i for i in instructions if
+                      (i.imm_size == 4 and i.address + i.imm_offset == where)
+                      or (kind == 6 and i.disp_size == 4 and i.address + i.disp_offset == where)]
+            if len(owners) != 1:
+                return False
+            if kind == 0x14 and not (owners[0].group(cs.CS_GRP_CALL) or owners[0].group(cs.CS_GRP_JUMP)):
+                return False
+        boundaries = {i.address for i in instructions}
+        fields = {w for w, _, _ in relocs}
+        for ins in instructions:
+            # A source constant can be folded into a second, different pointer
+            # value. Do not infer scalar-only use from the original DWORD count
+            # while an unrelocated image operand survives elsewhere in the body.
+            for op in ins.operands:
+                if op.type == x.X86_OP_IMM and IMAGE_LOW <= op.imm < IMAGE_HIGH:
+                    if ins.address + ins.imm_offset not in fields and not (
+                            ins.id == x.X86_INS_PUSH and ins.size == 5 and ins.bytes[0] == 0x68
+                            and op.imm in self.candidates):
+                        return False
+                if (op.type == x.X86_OP_MEM and IMAGE_LOW <= op.mem.disp < IMAGE_HIGH
+                        and ins.address + ins.disp_offset not in fields):
+                    return False
+        for ins in native_instructions:
+            if any(op.type == x.X86_OP_MEM and op.mem.base == x.X86_REG_ESP
+                   and op.mem.disp < 0 for op in ins.operands):
+                return False  # popped argument bytes must not be read back
+            if ins.group(cs.CS_GRP_CALL) or ins.group(cs.CS_GRP_JUMP):
+                if len(ins.operands) != 1 or ins.operands[0].type != x.X86_OP_IMM:
+                    return False  # no proof about an indirect overlapping entry
+                target = ins.operands[0].imm
+                if 0 <= target < len(raw) and target not in boundaries:
+                    return False
+            # Explicit aliases of the stack pointer could access the pushed
+            # word through an otherwise register-based scheduling instruction.
+            if (ins.id in (x.X86_INS_MOV, x.X86_INS_LEA) and len(ins.operands) == 2
+                    and ins.operands[0].type == x.X86_OP_REG
+                    and ins.operands[0].reg not in (x.X86_REG_ESP, x.X86_REG_EBP)
+                    and (ins.operands[1].type == x.X86_OP_REG
+                         and ins.operands[1].reg == x.X86_REG_ESP
+                         or ins.operands[1].type == x.X86_OP_MEM and ins.id == x.X86_INS_LEA
+                         and x.X86_REG_ESP in (ins.operands[1].mem.base, ins.operands[1].mem.index))):
+                return False
+        push = next((n for n, i in enumerate(instructions)
+                     if i.address + 1 == offset and i.id == x.X86_INS_PUSH
+                     and i.size == 5 and i.bytes[0] == 0x68), None)
+        if push is None or any(w < offset + 4 and offset < w + 4 for w, _, _ in relocs):
+            return False
+        # A small scheduling window may contain register address calculations or
+        # scalar stores, but no read of the pushed word, stack change or branch.
+        for ins in instructions[push + 1:push + 5]:
+            if ins.id == x.X86_INS_CALL and ins.size == 5 and ins.bytes[0] == 0xE8:
+                matches = [(k, r) for w, k, r in relocs if w == ins.address + 1]
+                if len(matches) != 1 or matches[0][0] != 0x14:
+                    return False
+                ref = matches[0][1]
+                if ref["storage"] != 2 or struct.unpack_from("<I", raw, ins.address + 1)[0]:
+                    return False
+                if any(w < ins.address + ins.size and offset - 1 < w + (2 if k == 0xA else 4)
+                       and w != ins.address + 1 for w, k, _ in relocs):
+                    return False
+                native = self.truth._read(start + ins.address + 1, 4)
+                if native is None:
+                    return False
+                target = start + ins.address + 5 + struct.unpack("<i", native)[0]
+                if set(self.truth.ledger.get(ref["name"], ())) != {target}:
+                    return False
+                # RET 4 consumes the argument but leaves its bytes below ESP.
+                # Admit only a straight-line remainder that cannot descend to
+                # that slot again. Ordinary POP/LEAVE/RET epilogues discard
+                # older frame words; calls, pushes and explicit SP writes do
+                # not establish that one-way property.
+                for later in instructions[push + 1:]:
+                    if later.address <= ins.address:
+                        continue
+                    if (later.group(cs.CS_GRP_CALL) or later.group(cs.CS_GRP_JUMP)
+                            or any(op.type == x.X86_OP_MEM and x.X86_REG_ESP in
+                                   (op.mem.base, op.mem.index) for op in later.operands)):
+                        return False
+                    _, writes = later.regs_access()
+                    if x.X86_REG_ESP in writes and later.id not in (
+                            x.X86_INS_POP, x.X86_INS_LEAVE, x.X86_INS_RET):
+                        return False
+                    if later.id == x.X86_INS_POP and any(
+                            op.type != x.X86_OP_REG or op.reg == x.X86_REG_ESP for op in later.operands):
+                        return False
+                return self._consumer(ref["name"])
+            operands = ins.operands
+            if (ins.id == x.X86_INS_LEA and len(operands) == 2
+                    and operands[0].type == x.X86_OP_REG and operands[0].reg != x.X86_REG_ESP
+                    and operands[1].type == x.X86_OP_MEM
+                    and operands[1].mem.base != x.X86_REG_ESP
+                    and operands[1].mem.index != x.X86_REG_ESP):
+                continue
+            if (ins.id == x.X86_INS_MOVSS and len(operands) == 2
+                    and operands[0].type == x.X86_OP_MEM and operands[1].type == x.X86_OP_REG
+                    and operands[0].mem.base != x.X86_REG_ESP
+                    and operands[0].mem.index != x.X86_REG_ESP):
+                continue
+            return False
+        return False
+
+    def values(self, text, source, path, candidates):
+        import build
+
+        self.candidates = candidates
+        rows = [r for r in self.rows if r["source"] == source]
+        if not rows or (build.ROOT / source).read_text(encoding="utf-8", errors="replace") != text:
+            return set()
+        o = self._object(rows[0])
+        if o.path.resolve() != path.resolve():
+            return set()
+        bodies = []
+        for row in rows:
+            try:
+                sym, raw, relocs = self._body(o, row, identity=False)
+                bodies.append((sym["section"], raw, relocs, int(row["target_rva"], 16)))
+            except ValueError:
+                continue
+        scalar = set()
+        source_counts = {}
+        for match in IMAGE_HEX.finditer(COMMENTS.sub(" ", text)):
+            value = int(match.group(1), 16)
+            source_counts[value] = source_counts.get(value, 0) + 1
+        for value in candidates:
+            encoded = struct.pack("<I", value)
+            occurrences = []
+            for section, (size, ptr, _, _, flags) in enumerate(o.sections, 1):
+                if not ptr or not flags & 0xE0000000:
+                    continue  # only bytes that can exist in the loaded image
+                raw = o.data[ptr:ptr + size]
+                offset = raw.find(encoded)
+                while offset >= 0:
+                    occurrences.append((section, offset))
+                    offset = raw.find(encoded, offset + 1)
+            if not occurrences or len(occurrences) != source_counts.get(value):
+                continue
+            proven = True
+            for section, offset in occurrences:
+                owners = [(raw, rs, start) for s, raw, rs, start in bodies
+                          if s == section and offset + 4 <= len(raw)]
+                if len(owners) != 1 or not self._site(*owners[0], offset):
+                    proven = False
+                    break
+            if proven:
+                scalar.add(value)
+        # Keep the proof bound to the same current source/object inputs even
+        # when a callee provider was read outside the caller's ordinary scope.
+        if (build.ROOT / source).read_text(encoding="utf-8", errors="replace") != text:
+            return set()
+        for row, source_path, obj_path, content, source_content in self.used:
+            if (build.row_object(row).resolve() != obj_path.resolve()
+                    or obj_path.read_bytes() != content
+                    or source_path.read_bytes() != source_content
+                    or not build.compile_is_current(source_path, obj_path)):
+                return set()
+        return scalar
+
+
