#!/usr/bin/env bash
# A commit that changes verifier code or a baseline must say why in a
# `Verifier-Change: <reason>` trailer, and a shrink-only baseline may not grow
# (tools/protected_paths.py). This is the one hook that sees the message.
# The checker runs AS OF HEAD, so an edit to it cannot approve itself.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
checker=tools/protected_paths.py
if git cat-file -e "HEAD:$checker" 2>/dev/null; then
    git show "HEAD:$checker" | python3 - --commit-msg "$1" \
        || { echo "COMMIT-MSG FAILED: protected verifier/baseline change (see above)" >&2; exit 1; }
elif [ -f "$checker" ]; then
    python3 "$checker" --commit-msg "$1" \
        || { echo "COMMIT-MSG FAILED: protected verifier/baseline change (see above)" >&2; exit 1; }
fi

# Pre-commit cannot read the eventual message. Finish its deferred disappearance
# checks here, using HEAD's implementation, index presence (never working-tree
# disappearance), staged-input binding, and this commit's actual message. Only
# per-key Debt-Retired explanations can account for otherwise unexplained debt.
if git cat-file -e HEAD:tools/repair_queue.py 2>/dev/null; then
    debt_checker=$(mktemp)
    git show HEAD:tools/repair_queue.py > "$debt_checker"
    # Older HEADs do not defer any checks and have no verify-missing command.
    if grep -q '^def verify_missing_debt(' "$debt_checker"; then
        python3 - verify-missing "$1" < "$debt_checker" \
            || { rm -f "$debt_checker"; echo "COMMIT-MSG FAILED: disappearing debt has no accounting (see above)" >&2; exit 1; }
    fi
    rm -f "$debt_checker"
fi
