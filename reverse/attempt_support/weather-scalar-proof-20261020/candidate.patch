+def test_every_repeated_code_occurrence_must_be_scalar(scalar_call):
+    f = scalar_call
+    f.text = "consume(0x886655); consume(0x886655);\n"
+    f.raw = f.raw[:-1] * 2 + b"\xc3"
+    f.relocs = [(6, 1, 0x14), (16, 1, 0x14)]
+    f.save()
+    # Even two safe consumers are conservative: the second PUSH reuses the
+    # first call's popped slot, outside this bounded straight-line suffix.
+    assert f.findings() == ["0x886655", "0x886655"]
+    # Changing only the second use to a raw-address load must retain the finding.
+    f.raw = f.raw[:10] + b"\xa1" + struct.pack("<I", f.value) + b"\xc3"
+    f.relocs = [(6, 1, 0x14)]
+    f.save()
+    assert f.findings() == ["0x886655", "0x886655"]
+
