+    def definition(self, name):
+        """(symbol, why) for the one symbol called `name` defined in this object."""
+        found = [s for s in self.symbols.values() if s["name"] == name and s["section"] > 0]
+        if len(found) != 1:
+            return None, f"{name} is not defined once in {self.path.name} ({len(found)} definition(s))"
+        return found[0], None
+
+    def static_definitions(self, name):
+        """The class-3 definitions of `name`; one is a TU-local datum, two are no owner."""
+        return [s for s in self.symbols.values()
