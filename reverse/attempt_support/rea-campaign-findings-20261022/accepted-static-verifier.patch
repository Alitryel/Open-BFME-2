+def test_a_row_shorter_than_the_whole_function_body_places_nothing(tmp_path, monkeypatch):
+    """Round14: a 6 B row in a 12 B non-padding function was accepted because
+    only the first 6 B were compared and the section tail was treated as body."""
+    tail = b"\xb8\x01\x00\x00\x00\xc3"                 # mov eax,1; ret: another body
+    body = b"\xa0" + struct.pack("<I", 0) + RET + tail
+    obj, snapshot = custom_text(tmp_path, monkeypatch, body,
+                                [(".text", 0, 1, 3), ("_f", 0, 1, 2, 0x20), (SEP, 0, 2, 3)],
+                                [(1, 2, data_rows.DIR32)])
+    retail = b"\xa0" + struct.pack("<I", BASE + 0x3000) + RET + tail
+    image = image_with(data=b"\n", text=retail)
+    assert data_rows.own_tu_reference_bases("Code/G.cpp", SEP, one_function_row(), snapshot, image) == set()
+    sym = snapshot.definition("_f")[0]
+    ok, why, fields = data_rows._function_body_matches(snapshot, sym, retail, 6)
+    assert not ok and "is 12 B" in why and fields == []
+    code, logged = gate(tmp_path, monkeypatch, dict(zip(data_rows.FIELDS, srow())), image,
+                        current=True, function_rows=one_function_row())
+    assert code == 1 and "no verified same-source reference" in logged[0], logged
