+// Compare typed nodes inline instead of emitting the non-retail base wrapper.
+template <class T, class Traits>
+static inline bool operator!=(const _List_iterator<T, Traits> &a,
+                              const _List_iterator<T, Traits> &b)
+{ return a._M_node != b._M_node; }
+
+// STLport's native find wrapper delegates to the input-iterator search.
+struct input_iterator_tag {};
+template <class InputIter, class T> __declspec(noinline)
+InputIter __find(InputIter first, InputIter last, const T &val,
+                 const input_iterator_tag &)
+{
+    while (first != last && !(*first == val))
+        ++first;
+    return first;
@@ -80,0 +91,3 @@
+template <class InputIter, class T> __declspec(noinline)
+InputIter find(InputIter first, InputIter last, const T &val)
+{ return __find(first, last, val, input_iterator_tag()); }
