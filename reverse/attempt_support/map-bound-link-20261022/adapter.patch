+// Retail bound workers use unsigned comparisons (4FF3B6/4FF539), as
+// independently verified by stlport_map_int_ptr_lower.cpp. Retain the
+// established signed-key wrapper ABI while delegating to those providers.
+namespace _STL {
+typedef _Rb_tree<unsigned, pair<const unsigned, void *>, _Select1st<pair<const unsigned, void *> >, less<unsigned>, allocator<pair<const unsigned, void *> > > BfmeUnsignedBoundTree;
+typedef _Rb_tree<int, pair<const int, void *>, _Select1st<pair<const int, void *> >, less<int>, allocator<pair<const int, void *> > > BfmeSignedBoundTree;
+template <> BfmeUnsignedBoundTree::_Link_type BfmeUnsignedBoundTree::_M_lower_bound(const unsigned &) const;
+template <> BfmeUnsignedBoundTree::_Link_type BfmeUnsignedBoundTree::_M_upper_bound(const unsigned &) const;
+template <> __declspec(dllimport) __forceinline
+BfmeUnsignedBoundTree::const_iterator BfmeUnsignedBoundTree::lower_bound(const unsigned &key) const
+{ return const_iterator(_M_lower_bound(key)); }
+template <> __declspec(dllimport) __forceinline
+BfmeUnsignedBoundTree::const_iterator BfmeUnsignedBoundTree::upper_bound(const unsigned &key) const
+{ return const_iterator(_M_upper_bound(key)); }
+template <> __declspec(dllimport) __forceinline
+BfmeSignedBoundTree::_Link_type BfmeSignedBoundTree::_M_lower_bound(const int &key) const
+{
+ return (BfmeSignedBoundTree::_Link_type)((const BfmeUnsignedBoundTree *)this)->lower_bound((const unsigned &)key)._M_node;
+}
+template <> __declspec(dllimport) __forceinline
+BfmeSignedBoundTree::_Link_type BfmeSignedBoundTree::_M_upper_bound(const int &key) const
+{
+ return (BfmeSignedBoundTree::_Link_type)((const BfmeUnsignedBoundTree *)this)->upper_bound((const unsigned &)key)._M_node;
+}
+template <> __declspec(dllimport) __forceinline
+BfmeSignedBoundTree::iterator BfmeSignedBoundTree::lower_bound(const int &key)
+{ return iterator(_M_lower_bound(key)); }
+template <> __declspec(dllimport) __forceinline
+BfmeSignedBoundTree::const_iterator BfmeSignedBoundTree::lower_bound(const int &key) const
+{ return const_iterator(_M_lower_bound(key)); }
+template <> __declspec(dllimport) __forceinline
+BfmeSignedBoundTree::iterator BfmeSignedBoundTree::upper_bound(const int &key)
+{ return iterator(_M_upper_bound(key)); }
+template <> __declspec(dllimport) __forceinline
+BfmeSignedBoundTree::const_iterator BfmeSignedBoundTree::upper_bound(const int &key) const
+{ return const_iterator(_M_upper_bound(key)); }
+
+}
