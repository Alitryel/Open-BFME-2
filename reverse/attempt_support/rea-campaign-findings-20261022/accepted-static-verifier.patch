@@ -0,0 +1,210 @@
+"""The data ledger's schema transition: nine columns in, ten columns now.
+
+The `linkage` column was added after 2,128 rows were written, so a commit that
+adds it is compared with a HEAD/base that still spells the nine-column header.
+Round 9 required the ten-column header in every reader, which made the hooks
+refuse the transition itself before any source could be verified. These tests
+pin the narrow compatibility: the two exact headers are read, a legacy record
+normalizes to `linkage=""` (external), the CURRENT ledger must still spell the
+ten-column header, and every malformed shape stays refused.
+"""
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import data_rows  # noqa: E402
+import delta_sources  # noqa: E402
+import flag_delta_sources  # noqa: E402
+from test_data_rows import SECTIONS  # noqa: E402
+
+LEDGER = "reverse/data_rows.csv"
+OLD = (b"name,address,address_kind,size,section,source,status,evidence,model\n"
+       b"?g@@3HA,0x00403000,va,4,.data,Code/G.cpp,matched,e,m\n")
+NEW = (b"name,address,address_kind,size,section,source,status,evidence,model,linkage\n"
+       b"?g@@3HA,0x00403000,va,4,.data,Code/G.cpp,matched,e,m,\n")
+STATIC = (b"name,address,address_kind,size,section,source,status,evidence,model,linkage\n"
+          b"?g@@3HA,0x00403000,va,4,.data,Code/G.cpp,matched,e,m,\n"
+          b"_sep,0x00403004,va,1,.data,Code/H.cpp,matched,e,m,static\n")
+
+
+# --------------------------------------------------------------------------- data_rows
+
+def test_parse_reads_the_legacy_header_and_normalizes_to_external():
+    meta = {}
+    rows = data_rows.parse(OLD, meta)
+    assert meta == {"legacy": True}
+    assert rows[0][1]["linkage"] == "" and data_rows.linkage_of(rows[0][1]) == data_rows.EXTERNAL_ROW
+    assert data_rows.parse(NEW)[0][1]["linkage"] == ""
+    assert data_rows.load.__doc__.splitlines()[0].startswith("The EXTERNAL rows")
+
+
+def test_the_current_ledger_must_spell_the_ten_column_header(tmp_path):
+    problems = []
+    assert data_rows.check(NEW, problems, sections=SECTIONS) == 1 and problems == []
+    problems = []
+    data_rows.check(OLD, problems, sections=SECTIONS)
+    assert any("legacy nine-column" in problem for problem in problems), problems
+    # a historical reader may ask for the lenient form explicitly
+    problems = []
+    data_rows.check(OLD, problems, sections=SECTIONS, require_current=False)
+    assert problems == []
+
+
+@pytest.mark.parametrize("raw, expected", [
+    (b"name,address,size,address_kind,section,source,status,evidence,model\n", "bad header"),
+    (b"name,address,address_kind,size,section,source,status,evidence,model,linkage,extra\n", "bad header"),
+    (b"name,address,address_kind,size,section,source,status,evidence,model\n"
+     b"?g@@3HA,0x00403000,va,4,.data,Code/G.cpp,matched,e,m,\n", "10 fields, expected 9"),
+    (b"name,address,address_kind,size,section,source,status,evidence,model,linkage\n"
+     b"?g@@3HA,0x00403000,va,4,.data,Code/G.cpp,matched,e,m,external,extra\n", "11 fields, expected 10"),
+])
+def test_malformed_headers_and_widths_stay_refused(raw, expected):
+    problems = []
+    if "bad header" in expected:
+        with pytest.raises(ValueError, match="bad header"):
+            data_rows.parse(raw)
+        return
+    data_rows.check(raw, problems, sections=[])
+    assert any(expected in problem for problem in problems), problems
+
+
+# --------------------------------------------------------------------------- delta_sources
+
+def fake_git(blobs, trees):
+    """delta_sources.git_bytes over {oid: blob} and {ref/tree: oid}."""
+    def git_bytes(*args):
+        if args[0] == "rev-parse":
+            return trees[args[-1].split("^{tree}")[0]].encode()
+        if args[0] == "ls-tree":
+            return f"100644 blob {trees[args[2]]}\t{args[-1]}".encode() + b"\0"
+        if args[0] == "ls-files":
+            return f"100644 {trees[':']} 0\t{args[-1]}".encode() + b"\0"
+        if args[0] == "cat-file":
+            return blobs[args[2]]
+        raise AssertionError(args)
+    return git_bytes
+
+
+@pytest.fixture
+def staged(monkeypatch):
+    trees = {"HEAD": "old", "old": "old", ":": "new", "new": "new"}
+    monkeypatch.setattr(delta_sources, "git_bytes", fake_git({"old": OLD, "new": NEW}, trees))
+    args = type("Args", (), {"staged": True, "range": None})()
+    return args
+
+
+@pytest.fixture
+def ranged(monkeypatch):
+    trees = {"A": "ta", "ta": "old", "B": "tb", "tb": "new"}
+    monkeypatch.setattr(delta_sources, "git_bytes", fake_git({"old": OLD, "new": NEW}, trees))
+    return type("Args", (), {"staged": False, "range": ("A", "B")})()
+
+
