/// \fn Module *W3DSupplyDraw::friend_newModuleInstance(Thing *thing, const ModuleData *moduleData)
/// \brief Instance factory registered for "W3DSupplyDraw": creates the
///        module for one drawable.
///
/// Same pattern as W3DBuffDraw::friend_newModuleInstance.
///
/// \param thing       The drawable being built.
/// \param moduleData  The template's shared supply module data.
/// \return The new module, as a Module pointer.
/// \see W3DSupplyDraw::friend_newModuleData

/// \fn ModuleData *W3DSupplyDraw::friend_newModuleData(INI *ini)
/// \brief Data factory registered for "W3DSupplyDraw": creates
