+    assert "overlaps" in problems_of(ledger(srow(size="2"), srow("_wide", "0x00403001", size="4",
+                                                                 linkage="external")))[0]
+    assert "one owner per address" in problems_of(ledger(srow(), srow("_wide", size="4")))[0]
+
+
+def test_only_external_or_static_is_a_linkage():
+    for value in ("local", "STATIC", "global", "internal"):
+        assert "linkage must be `external` or `static`" in problems_of(ledger(srow(linkage=value)))[0], value
+    assert problems_of(ledger(srow(linkage="external"))) == []
+
+
+def test_a_record_without_the_linkage_column_is_external(tmp_path, monkeypatch):
