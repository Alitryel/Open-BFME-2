+def test_a_cold_cache_accepts_the_object_verify_just_built(tmp_path, monkeypatch):
+    """Round 9 computed the tie BEFORE verify_row compiled: a cold cache
+    rejected the row after generating the correct object."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    _obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000], write=False)
+    obj = tmp_path / "G.obj"          # absent: the build creates it
+    assert not obj.exists()
+    code, logged = gate(tmp_path, monkeypatch, entry, image,
+                        rebuild=cold_rebuild(obj, [("_f", 0, 0xA0)]))
+    assert obj.exists() and code == 1, logged
+    assert logged == ["Data rows: OK (1 row(s) byte-verified)"]
