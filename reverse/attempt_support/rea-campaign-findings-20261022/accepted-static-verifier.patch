+    assert data_rows.own_tu_reference_bases("Code/G.cpp", SEP, rows, snapshot, image) == set()
+    ok, why, fields = data_rows._function_body_matches(
+        snapshot, snapshot.definition("_f")[0], retail, 6)
+    assert not ok and "is 7 B" in why and fields == []
+    code, logged = gate(tmp_path, monkeypatch, dict(zip(data_rows.FIELDS, srow())), image,
+                        current=True, function_rows=rows)
+    assert code == 1 and "no verified same-source reference" in logged[0], logged
+    # the existing byte gate refuses the same fixture for the same reason
+    build = data_rows._tools()[0]
+    monkeypatch.setattr(build, "read_target_bytes", lambda rva, size: retail[:size])
+    row = {"name": "_f", "source": "Code/G.cpp", "notes": "",
+           "target_rva": "0x1000", "target_size": "6"}
+    problems = build.body_extent_problems(
+        row, {"target_rva": 0x1000, "target": retail[:6]}, {}, obj, [0x1000])
+    assert [check for check, _ in problems] == ["tail"], problems
