+def tie(tmp_path, monkeypatch, refs, pointers, **kwargs):
+    obj, image, rows = tree(tmp_path, monkeypatch, refs, pointers, **kwargs)
+    snapshot = data_rows.ObjectSnapshot("Code/G.cpp", obj, obj.read_bytes())
+    return snapshot, image, rows
+
