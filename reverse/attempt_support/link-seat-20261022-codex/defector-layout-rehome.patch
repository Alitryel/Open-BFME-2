+// Scoped BFME2 layout adaptation of BFME1 42bba2ddbd5cb895d99293583891d3b7315fa49e
+// inputs/reference/shims/specialpowermoduledata/GameLogic/Module/SpecialPowerModule.h.
+// Only the base extent changes; the additional fields remain unidentified.
+// TU-scoped shim: Zero Hour GameLogic/Module/SpecialPowerModule.h with
+// SpecialPowerModuleData's destructor declared out of line (BFME keeps it at
+// retail 0x00258730). Upstream: inputs/reference/CnC_Generals_Zero_Hour/GeneralsMD/
+// Code/GameEngine/Include/GameLogic/Module/SpecialPowerModule.h
+/*
