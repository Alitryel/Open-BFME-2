+def test_a_source_mutated_during_the_size_probe_fails_closed(tmp_path, monkeypatch):
+    """Round14: the object digest stayed valid while the sizeof callback edited
+    the source. compile=True claims the source emits the object, so the source
+    and build inputs are re-checked after the proofs."""
+    entry = dict(zip(data_rows.FIELDS, srow()))
+    _obj, image, _rows = tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000])
