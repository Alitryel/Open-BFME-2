-// Select-any like every other TU's copy (a strong definition would duplicate theirs at link time);
-// the anchor keeps the noinline body emitted.
+// Copy the four scalar rows directly; no out-of-line Vector4 assignment is needed.
+// ?bfmeCopyTransform absent-from-retail
+static __forceinline void bfmeCopyTransform(Matrix4 &to, const Matrix4 &from)
+{
+ to[0].X=from[0].X; to[0].Y=from[0].Y; to[0].Z=from[0].Z; to[0].W=from[0].W;
+ to[1].X=from[1].X; to[1].Y=from[1].Y; to[1].Z=from[1].Z; to[1].W=from[1].W;
+ to[2].X=from[2].X; to[2].Y=from[2].Y; to[2].Z=from[2].Z; to[2].W=from[2].W;
+ to[3].X=from[3].X; to[3].Y=from[3].Y; to[3].Z=from[3].Z; to[3].W=from[3].W;
+}
+// Keep the shared entry as a select-any definition.
