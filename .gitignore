build/
.venv/
__pycache__/
*.pyc

# Machine-local game-test configuration (X display numbers, wine prefix paths).
.env

reverse/.add_match.lock
reverse/zh_sweep/locate_state.json
# The drift tier's queue, rebuilt per clone by tools/drift_classify.py from
# the retail image and the ledger. Nothing tracks it, so every clone carried
# it as a permanently untracked file -- noise in `git status` that also makes
# an accidental `git add .` commit a machine-local cache.
reverse/zh_sweep/drift_report.csv

# Alternate-case sweep shims: only the canonical spelling of each dual-case
# include is committed (a case-only-colliding path breaks Windows/macOS
# checkout). tools/gen_case_shims.py regenerates these at build time.
reference/shims/sweep/mss.h
reference/shims/sweep/wsys/file.h
reference/shims/sweep/stdAfx.h
reference/shims/sweep/WorldBuilder.h
reference/shims/sweep/wpaudio/Source.h
reference/shims/sweep/D3DX8Math.h
