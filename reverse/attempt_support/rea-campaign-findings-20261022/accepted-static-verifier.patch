+    against its own object at its own retail address, and neither is a home."""
+    for source, address, byte in (("Code/G.cpp", 0x00403000, b"\x0a"), ("Code/H.cpp", 0x00403004, b"\x0d")):
+        tree(tmp_path, monkeypatch, [("_f", 0, 0xA0)], [BASE + 0x3000], data=byte)
+        (tmp_path / "Code/G.cpp").write_text("// fixture\n")
+        (tmp_path / "Code/H.cpp").write_text("// fixture\n")
+        image = image_with(data=b"\x0a\x00\x00\x00\x0d")
+        ok, message = verify_entry(image, srow(address=f"0x{address:08X}", source=source))
+        assert ok, message
+        # and the other unit's byte is not this row's datum
+        other = 0x00403004 if address == 0x00403000 else 0x00403000
+        ok, message = verify_entry(image, srow(address=f"0x{other:08X}", source=source))
+        assert not ok and "differs" in message
