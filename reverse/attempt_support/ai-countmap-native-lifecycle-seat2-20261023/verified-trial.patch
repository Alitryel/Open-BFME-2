+
+enum NameKeyType {
+ NAMEKEY_INVALID=0,
+ NAMEKEY_MAX=1<<23,
+ FORCE_NAMEKEYTYPE_LONG=0x7fffffff
+};
+namespace rts {
+template<class Key> struct hash;
+template<> struct hash<NameKeyType> {
