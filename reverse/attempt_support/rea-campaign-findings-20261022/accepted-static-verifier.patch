+def cold_rebuild(obj, refs, addend=0):
+    def compile_source(source, target):
+        write_refs(target, refs, b"\n", sep=(2, 3))
+        write_receipt(target, source)     # a real build writes both the object and its receipt
+        return True, "simulated rebuild", None
+    return compile_source
